{
  "name": "mellow",
  "version": "0.1.0",
  "description": "A lightweight local desktop time tracker for managing tasks, tracking work sessions, adding manual time entries, and writing notes with Markdown support. The app stores all data locally, supports multiple languages, and provides a clean overview of active and completed tasks.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addictedsociety/mellow.git"
  },
  "keywords": [],
