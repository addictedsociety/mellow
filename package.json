  "license": "MIT",
  "bugs": {
    "url": "https://github.com/addictedsociety/mellow/issues"
  },
  "homepage": "https://github.com/addictedsociety/mellow#readme",
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "dompurify": "^3.4.1",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.1.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.33",
    "vue-i18n": "^11.4.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.11.0",
